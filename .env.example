# 复制为 .env 后填写（.env 已被 .gitignore 排除）

# 模型密钥（不填也能启动，AI 回答会失败）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 管理后台初始密码（只在首次建库时生效）
BYTEDESK_ADMIN_PASSWORD=SelfDesk#2026

# PostgreSQL（compose 内部使用；容器间主机名为 postgres）
POSTGRES_DB=bytedesk
POSTGRES_USER=bytedesk
POSTGRES_PASSWORD=bytedesk_local

# JVM 堆
JAVA_OPTS=-Xms512m -Xmx1280m
