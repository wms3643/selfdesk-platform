<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        客服机器人默认采用严格检索模式：识别为知识意图时，知识库未启用或检索为空
        不再让 LLM 自由作答。闲聊意图仍可直接回答。
        仅调整 SERVICE 类型，保留 LLM/ASSISTANT 机器人的既有自由对话行为。
        如某个客服机器人确实需要开放聊天，可在机器人配置中显式将
        llm_use_when_kb_empty 改为 true。
    -->
    <changeSet id="261017-1-enforce-rag-for-service-robots" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_ai_robot"/>
            <columnExists tableName="bytedesk_ai_robot" columnName="llm_use_when_kb_empty"/>
            <columnExists tableName="bytedesk_ai_robot" columnName="robot_type"/>
        </preConditions>
        <update tableName="bytedesk_ai_robot">
            <column name="llm_use_when_kb_empty" valueBoolean="false"/>
            <where>robot_type = 'SERVICE'</where>
        </update>
    </changeSet>

</databaseChangeLog>
